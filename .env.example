# Environment Configuration Example
# Copy this file to .env and modify as needed

# ==========================================
# ENVIRONMENT SETTINGS
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=info

# ==========================================
# API SETTINGS
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ==========================================
# STREAMLIT SETTINGS
# ==========================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_TOOLBAR_MODE=auto

# ==========================================
# MODEL PATHS
# ==========================================
BAG_MODEL_PATH=best_int8_openvino_model
PERSON_MODEL_PATH=yolov8n.pt

# ==========================================
# DATABASE SETTINGS
# ==========================================
DATABASE_URL=sqlite:///./forensic_detections.db
DATABASE_ECHO=false

# ==========================================
# CAMERA SETTINGS
# ==========================================
CAMERA_INDEX=0
CAMERA_COUNT=1
CAMERA_TIMEOUT=30
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080

# ==========================================
# DETECTION SETTINGS
# ==========================================
CONFIDENCE_THRESHOLD=0.35
ABANDONED_TIME_LIMIT=5
DYNAMIC_TOLERANCE_PCT=0.10
GRACE_PERIOD=2.0

# ==========================================
# FILE PATHS
# ==========================================
EVIDENCE_FOLDER=evidence
LOGS_FOLDER=logs

# ==========================================
# ALERT SETTINGS (for future notifications)
# ==========================================
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# SECURITY SETTINGS (Production Only)
# ==========================================
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ==========================================
# NGINX SETTINGS (if using Nginx proxy)
# ==========================================
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
